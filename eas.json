{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://next-clean.demo.minimonster.id",
        "EXPO_PUBLIC_USE_MOCK_API": "false"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://next-clean.demo.minimonster.id",
        "EXPO_PUBLIC_USE_MOCK_API": "false"
      }
    }
  }
}
